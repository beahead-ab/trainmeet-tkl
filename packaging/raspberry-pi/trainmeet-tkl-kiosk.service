[Unit]
Description=TrainMeet TKL touch terminal kiosk
After=graphical.target trainmeet-tkl.service
Wants=graphical.target trainmeet-tkl.service

[Service]
User=trainmeet-tkl
Group=trainmeet-tkl
Environment=HOME=/var/lib/trainmeet-tkl
WorkingDirectory=/var/lib/trainmeet-tkl
ExecStart=/usr/bin/xinit /usr/local/bin/trainmeet-tkl-kiosk -- :0 vt1 -keeptty -nocursor
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
