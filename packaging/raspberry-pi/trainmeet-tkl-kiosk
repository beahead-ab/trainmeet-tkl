#!/bin/sh
set -eu

xset s off
xset -dpms
xset s noblank
openbox-session &
unclutter -idle 0.1 -root &

ORIENTATION=$(python3 -c 'import json; from pathlib import Path; p=Path("/var/lib/trainmeet-tkl/terminal-config.json"); print(json.loads(p.read_text()).get("orientation", "portrait") if p.exists() else "portrait")' 2>/dev/null || printf portrait)
OUTPUT=$(xrandr --query | awk '/ connected/{print $1; exit}')
if [ -n "$OUTPUT" ]; then
  if [ "$ORIENTATION" = portrait ]; then
    xrandr --output "$OUTPUT" --rotate right
  else
    xrandr --output "$OUTPUT" --rotate normal
  fi
fi

exec chromium \
  --kiosk \
  --app=http://127.0.0.1:8790/ \
  --no-first-run \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --disable-pinch \
  --overscroll-history-navigation=0 \
  --password-store=basic \
  --start-fullscreen
