  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8790",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run typecheck && vite build",
    "build:server": "./scripts/install-into-trainmeet-server.sh",
